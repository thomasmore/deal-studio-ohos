import * as ui from "std/ui"
import * as time from "std/time"
@jsonable class AppState { count: number; day: number; }
function init(): AppState { return {count: 0, day: time.daysSinceEpoch()}; }
function add(state: AppState, value: number): AppState { return {count: state.count + value, day: state.day}; }
function view(state: AppState): ui.View { return ui.Column("default", [ui.NumberText("metric", state.count, "", " today", 1), ui.Button("primary", "+1", "add", 1, true)]); }
function widget(state: AppState): ui.View { return ui.Column("default", [ui.NumberText("metric", state.count, "", " today", 1), ui.Button("primary", "+1", "add", 1, true)]); }
function widgetRefresh(state: AppState): AppState {
  if (state.day === time.daysSinceEpoch()) { return state; }
  return {count: 0, day: time.daysSinceEpoch()};
}
