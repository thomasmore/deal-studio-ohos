// PillPal port: one module, one shared state, independent screen functions.
// Derived from the recovered competitor's behaviour, implemented against VERA's native catalogue.
@jsonable
class Medicine {
  id: number;
  name: string;
  dosage: string;
  notes: string;
  times: number[];
  weekdays: number[];
  startDay: number;
  endDay: number;
  revision: number;
}
@jsonable
class DoseRecord { medicineId: number; day: number; minute: number; status: string; at: number; }
@jsonable
class EventRef { medicineId: number; start: number; id: string; revision: number; }
@jsonable
class CalendarJob { kind: string; medicineId: number; start: number; id: string; revision: number; title: string; description: string; }
@jsonable
class AppState {
  medicines: Medicine[];
  log: DoseRecord[];
  refs: EventRef[];
  nextId: number;
  screen: string;
  returnScreen: string;
  draft: Medicine;
  timeIndex: number;
  deleteId: number;
  now: number;
  day: number;
  jobs: CalendarJob[];
  jobIndex: number;
  busy: boolean;
  lastRequestAt: number;
  calendarEnabled: boolean;
  lastSyncDay: number;
  message: string;
  error: string;
}
function copyState(state: AppState): AppState {
  return {medicines: state.medicines, log: state.log, refs: state.refs, nextId: state.nextId, screen: state.screen, returnScreen: state.returnScreen, draft: state.draft, timeIndex: state.timeIndex, deleteId: state.deleteId, now: state.now, day: state.day, jobs: state.jobs, jobIndex: state.jobIndex, busy: state.busy, lastRequestAt: state.lastRequestAt, calendarEnabled: state.calendarEnabled, lastSyncDay: state.lastSyncDay, message: state.message, error: state.error};
}
function copyNumbers(values: number[]): number[] {
  let result: number[] = [];
  for (let value: number of values) { result.push(value); }
  return result;
}
function copyMedicine(m: Medicine): Medicine {
  return {id: m.id, name: m.name, dosage: m.dosage, notes: m.notes, times: copyNumbers(m.times), weekdays: copyNumbers(m.weekdays), startDay: m.startDay, endDay: m.endDay, revision: m.revision};
}
function emptyMedicine(): Medicine {
  return {id: 0, name: "", dosage: "", notes: "", times: [480], weekdays: [0,1,2,3,4,5,6],
    startDay: time.daysSinceEpoch(), endDay: -1, revision: 1};
}
function init(): AppState {
  let medicines: Medicine[] = [];
  let log: DoseRecord[] = [];
  let refs: EventRef[] = [];
  let jobs: CalendarJob[] = [];
  return {medicines: medicines, log: log, refs: refs, nextId: 1, screen: "today", returnScreen: "today",
    draft: emptyMedicine(), timeIndex: 0, deleteId: 0, now: time.nowMillis(), day: time.daysSinceEpoch(),
    jobs: jobs, jobIndex: 0, busy: false, lastRequestAt: 0, calendarEnabled: false, lastSyncDay: -1,
    message: "", error: ""};
}
function hasNumber(values: number[], value: number): boolean {
  for (let item: number of values) { if (item === value) { return true; } }
  return false;
}
function medicineIndex(state: AppState, id: number): number {
  let i: number = 0;
  while (i < state.medicines.length()) {
    if (state.medicines[i].id === id) { return i; }
    i = i + 1;
  }
  return -1;
}
function scheduled(m: Medicine, day: number): boolean {
  return day >= m.startDay && (m.endDay < 0 || day <= m.endDay) && hasNumber(m.weekdays, (day + 4) % 7);
}
function doseStatus(state: AppState, id: number, day: number, minute: number): string {
  for (let entry: DoseRecord of state.log) {
    if (entry.medicineId === id && entry.day === day && entry.minute === minute) { return entry.status; }
  }
  return "";
}
function goToday(state: AppState, value: number): AppState {
  let next: AppState = copyState(state); next.screen = "today"; return next;
}
function goMedicines(state: AppState, value: number): AppState {
  let next: AppState = copyState(state); next.screen = "medicines"; return next;
}
function openNew(state: AppState, value: number): AppState {
  let next: AppState = copyState(state);
  next.returnScreen = state.screen; next.screen = "edit"; next.draft = emptyMedicine();
  next.timeIndex = 0; next.error = ""; return next;
}
function openEdit(state: AppState, id: number): AppState {
  let at: number = medicineIndex(state, id);
  if (at < 0) { return state; }
  let next: AppState = copyState(state);
  next.returnScreen = state.screen; next.screen = "edit"; next.draft = copyMedicine(state.medicines[at]);
  next.timeIndex = 0; next.error = ""; return next;
}
function cancelEdit(state: AppState, value: number): AppState {
  let next: AppState = copyState(state); next.screen = state.returnScreen;
  next.draft = emptyMedicine(); next.error = ""; return next;
}
function editState(state: AppState): AppState {
  let next: AppState = copyState(state); next.draft = copyMedicine(state.draft); next.error = ""; return next;
}
function setName(state: AppState, value: string): AppState {
  let next: AppState = editState(state); next.draft.name = value; return next;
}
function setDosage(state: AppState, value: string): AppState {
  let next: AppState = editState(state); next.draft.dosage = value; return next;
}
function setNotes(state: AppState, value: string): AppState {
  let next: AppState = editState(state); next.draft.notes = value; return next;
}
function setStart(state: AppState, value: number): AppState {
  let next: AppState = editState(state); next.draft.startDay = value; return next;
}
function setEnd(state: AppState, value: number): AppState {
  let next: AppState = editState(state); next.draft.endDay = value; return next;
}

function setHasEnd(state: AppState, value: boolean): AppState {
  let next: AppState = editState(state); next.draft.endDay = -1;
  if (value) { next.draft.endDay = next.draft.startDay + 13; }
  return next;
}
function selectTime(state: AppState, value: number): AppState {
  if (value < 0 || value >= state.draft.times.length()) { return state; }
  let next: AppState = copyState(state); next.timeIndex = value; return next;
}
function setTime(state: AppState, value: number): AppState {
  if (state.timeIndex < 0 || state.timeIndex >= state.draft.times.length() || value < 0 || value >= 1440) { return state; }
  let next: AppState = editState(state); next.draft.times[state.timeIndex] = math.floor(value); return next;
}
function addTime(state: AppState, value: number): AppState {
  let next: AppState = editState(state);
  let minute: number = 0;
  while (minute < 1440 && hasNumber(next.draft.times, minute)) { minute = minute + 30; }
  if (minute >= 1440) { return state; }
  next.draft.times.push(minute); next.timeIndex = next.draft.times.length() - 1; return next;
}
function removeTime(state: AppState, value: number): AppState {
  if (state.draft.times.length() <= 1) { return state; }
  let next: AppState = editState(state); let times: number[] = []; let i: number = 0;
  for (let minute: number of state.draft.times) {
    if (i !== state.timeIndex) { times.push(minute); }
    i = i + 1;
  }
  next.draft.times = times; next.timeIndex = 0; return next;
}
function toggleDay(state: AppState, value: number): AppState {
  if (value < 0 || value > 6) { return state; }
  let next: AppState = editState(state); let days: number[] = [];
  for (let day: number of state.draft.weekdays) { if (day !== value) { days.push(day); } }
  if (!hasNumber(state.draft.weekdays, value)) { days.push(value); }
  next.draft.weekdays = days; return next;
}
function presetDays(state: AppState, value: number): AppState {
  let next: AppState = editState(state);
  next.draft.weekdays = [0,1,2,3,4,5,6];
  if (value === 1) { next.draft.weekdays = [1,2,3,4,5]; }
  if (value === 2) { next.draft.weekdays = [0,6]; }
  return next;
}
function saveMedicine(state: AppState, value: number): AppState {
  if (state.busy) { return state; }
  let next: AppState = editState(state);
  next.draft.name = strings.trim(state.draft.name);
  if (next.draft.name === "") { next.error = "Give this medicine a name."; return next; }
  if (next.draft.weekdays.length() === 0) { next.error = "Choose at least one day."; return next; }
  if (next.draft.endDay >= 0 && next.draft.endDay < next.draft.startDay) {
    next.error = "End date must be on or after start date."; return next;
  }
  let times: number[] = [];
  for (let minute: number of state.draft.times) {
    if (!hasNumber(times, minute)) { times.push(minute); }
  }
  next.draft.times = times;
  let medicines: Medicine[] = [];
  if (next.draft.id === 0) {
    next.draft.id = state.nextId; next.nextId = state.nextId + 1;
  } else { next.draft.revision = state.draft.revision + 1; }
  for (let m: Medicine of state.medicines) {
    if (m.id !== next.draft.id) { medicines.push(m); }
  }
  medicines.push(next.draft); next.medicines = medicines; next.screen = "today";
  next.draft = emptyMedicine(); next.message = "Medicine saved. Updating calendar reminders.";
  return syncCalendar(next, 0);
}
function askDelete(state: AppState, id: number): AppState {
  if (medicineIndex(state, id) < 0) { return state; }
  let next: AppState = copyState(state); next.deleteId = id; next.screen = "delete"; return next;
}
function cancelDelete(state: AppState, value: number): AppState {
  let next: AppState = copyState(state); next.deleteId = 0; next.screen = "medicines"; return next;
}
function deleteMedicine(state: AppState, value: number): AppState {
  if (state.busy || medicineIndex(state, state.deleteId) < 0) { return state; }
  let next: AppState = copyState(state); let medicines: Medicine[] = []; let log: DoseRecord[] = [];
  for (let m: Medicine of state.medicines) { if (m.id !== state.deleteId) { medicines.push(m); } }
  for (let entry: DoseRecord of state.log) { if (entry.medicineId !== state.deleteId) { log.push(entry); } }
  next.medicines = medicines; next.log = log; next.deleteId = 0; next.screen = "medicines";
  next.message = "Medicine removed. Removing its upcoming reminders.";
  return syncCalendar(next, 0);
}
function markDose(state: AppState, value: number, status: string): AppState {
  let id: number = math.floor(value / 1440); let minute: number = value % 1440;
  let at: number = medicineIndex(state, id);
  if (at < 0) { return state; }
  if (!scheduled(state.medicines[at], state.day) || !hasNumber(state.medicines[at].times, minute)) { return state; }
  let next: AppState = copyState(state); let log: DoseRecord[] = [];
  for (let entry: DoseRecord of state.log) {
    if (!(entry.medicineId === id && entry.day === state.day && entry.minute === minute)) { log.push(entry); }
  }
  if (status !== "") {
    log.push({medicineId: id, day: state.day, minute: minute, status: status, at: time.nowMillis()});
  }
  next.log = log; return next;
}
function takeDose(state: AppState, value: number): AppState { return markDose(state, value, "taken"); }
function skipDose(state: AppState, value: number): AppState { return markDose(state, value, "skipped"); }
function undoDose(state: AppState, value: number): AppState { return markDose(state, value, ""); }

// Calendar jobs are serial and carry stable record identities. Switching views
// does not restart the VM or cancel their callbacks. Failed deletions retain IDs.
function wantedStart(state: AppState, ref: EventRef): boolean {
  let at: number = medicineIndex(state, ref.medicineId);
  if (at < 0) { return false; }
  let m: Medicine = state.medicines[at];
  if (m.revision !== ref.revision) { return false; }
  let count: number = 0; let day: number = state.day;
  while (day < state.day + 14 && count < 48) {
    if (scheduled(m, day)) {
      for (let minute: number of m.times) {
        let start: number = time.atLocalTime(day, minute);
        if (start > state.now + 30000 && count < 48) {
          count = count + 1; if (start === ref.start) { return true; }
        }
      }
    }
    day = day + 1;
  }
  return false;
}
function hasRef(state: AppState, id: number, revision: number, start: number): boolean {
  for (let ref: EventRef of state.refs) {
    if (ref.medicineId === id && ref.revision === revision && ref.start === start) { return true; }
  }
  return false;
}
function syncCalendar(state: AppState, value: number): AppState {
  if (state.busy) { return state; }
  let next: AppState = copyState(state);
  next.now = time.nowMillis(); next.day = time.daysSinceEpoch(); next.error = "";
  let jobs: CalendarJob[] = [];
  for (let ref: EventRef of state.refs) {
    if (ref.start > next.now - 60000 && !wantedStart(next, ref)) {
      jobs.push({kind: "delete", medicineId: ref.medicineId, start: ref.start, id: ref.id,
        revision: ref.revision, title: "", description: ""});
    }
  }
  for (let m: Medicine of state.medicines) {
    let day: number = next.day; let count: number = 0;
    while (day < next.day + 14 && count < 48) {
      if (scheduled(m, day)) {
        for (let minute: number of m.times) {
          let start: number = time.atLocalTime(day, minute);
          if (start > next.now + 30000 && count < 48) {
            count = count + 1;
            if (!hasRef(next, m.id, m.revision, start)) {
              jobs.push({kind: "create", medicineId: m.id, start: start, id: "", revision: m.revision,
                title: "Take " + m.name, description: "Dose: " + m.dosage + " / " + m.notes + " / Added by PillPal"});
            }
          }
        }
      }
      day = day + 1;
    }
  }
  next.jobs = jobs; next.jobIndex = 0; next.busy = true;
  return runNextJob(next);
}
function runNextJob(state: AppState): AppState {
  let next: AppState = copyState(state);
  if (state.jobIndex >= state.jobs.length()) {
    next.busy = false; next.calendarEnabled = true; next.lastSyncDay = state.day;
    next.message = "Calendar update completed. Reminders cover up to 14 days (48 per medicine).";
    return next;
  }
  let job: CalendarJob = state.jobs[state.jobIndex];
  next.lastRequestAt = time.nowMillis();
  if (job.kind === "delete") {
    sdk.call("CalendarKit.Calendar.deleteEvent", ["id", job.id], "onCalendarAnswer");
  } else {
    sdk.call("CalendarKit.Calendar.addEvent", ["title", job.title,
      "startTime", ui.numberToString(job.start), "endTime", ui.numberToString(job.start + 900000),
      "remindBefore", "0", "description", job.description], "onCalendarAnswer");
  }
  return next;
}
function onCalendarAnswer(state: AppState, value: string): AppState {
  if (!state.busy || state.jobIndex >= state.jobs.length()) { return state; }
  let next: AppState = copyState(state); let job: CalendarJob = state.jobs[state.jobIndex];
  let success: boolean = false;
  if (job.kind === "delete") { success = value === "ok"; }
  else { success = strings.toNumber(value, 0) > 0; }
  if (!success) {
    next.busy = false; next.error = "Calendar update stopped: " + value;
    next.message = "Your medicines are saved. Retry to finish pending reminders."; return next;
  }
  let refs: EventRef[] = [];
  for (let ref: EventRef of state.refs) {
    if (!(job.kind === "delete" && ref.id === job.id)) { refs.push(ref); }
  }
  if (job.kind === "create") {
    refs.push({medicineId: job.medicineId, start: job.start, id: value, revision: job.revision});
  }
  next.refs = refs; next.jobIndex = state.jobIndex + 1;
  return runNextJob(next);
}
function refresh(state: AppState, value: number): AppState {
  let next: AppState = copyState(state); next.now = time.nowMillis(); next.day = time.daysSinceEpoch();
  // A callback can be lost after a calendar request has already committed.
  // Do not automatically reissue an ambiguous create after an interruption:
  // it could duplicate a real calendar event. Manual reconciliation is required.
  if (state.busy && next.now - state.lastRequestAt > 60000) {
    next.busy = false;
    next.error = "Calendar request interrupted. Its outcome is unknown; review the phone calendar before retrying.";
  }
  if (!next.busy && next.error === "" && next.calendarEnabled && next.day - next.lastSyncDay >= 7) {
    return syncCalendar(next, 0);
  }
  return next;
}
function weekdayLabel(day: number): string {
  let labels: string[] = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"]; return labels[day];
}
function scheduleLabel(m: Medicine): string {
  let text: string = "";
  if (m.weekdays.length() === 7) { text = "Every day"; }
  else {
    for (let day: number of m.weekdays) { text = text + weekdayLabel(day) + " "; }
  }
  for (let minute: number of m.times) { text = text + " · " + ui.clockToString(minute); }
  return text;
}
function navigation(state: AppState): ui.View {
  let todayStyle: string = "secondary"; let medicinesStyle: string = "secondary";
  if (state.screen === "today") { todayStyle = "primary"; }
  if (state.screen === "medicines") { medicinesStyle = "primary"; }
  return ui.ActionBar("default", [
    ui.Button(todayStyle, "Today", "goToday", 0, true),
    ui.Button(medicinesStyle, "Medicines", "goMedicines", 0, true),
    ui.IconButton("primary", "plus", "Add medicine", "openNew", 0, true)
  ]);
}
function calendarView(state: AppState): ui.View {
  let detail: string = "Each dose gets a calendar event with an alert. Open this app regularly to extend coverage.";
  let title: string = "Calendar reminders"; let style: string = "surface";
  if (state.busy) {
    title = "Updating your calendar";
    detail = ui.numberToString(state.jobIndex) + " of " + ui.numberToString(state.jobs.length()) + " operations completed.";
  }
  if (state.error !== "") { style = "warning"; detail = state.error; }
  let children: ui.View[] = [ui.SectionHeader("default", title, detail, "")];
  if (state.busy) { children.push(ui.Progress("accent", "Calendar update", state.jobIndex, state.jobs.length())); }
  else { children.push(ui.Button("secondary", "Update reminders", "syncCalendar", 0, true)); }
  if (state.message !== "") { children.push(ui.Text("caption", state.message)); }
  return ui.Card(style, children);
}
function adherenceView(state: AppState): ui.View {
  let due: number = 0; let taken: number = 0; let day: number = state.day - 6;
  let totals: number[] = []; let counts: number[] = []; let labels: string[] = [];
  while (day <= state.day) {
    let dayDue: number = 0; let dayTaken: number = 0;
    for (let m: Medicine of state.medicines) {
      if (scheduled(m, day)) {
        for (let minute: number of m.times) {
          if (time.atLocalTime(day, minute) <= state.now) {
            dayDue = dayDue + 1;
            if (doseStatus(state, m.id, day, minute) === "taken") { dayTaken = dayTaken + 1; }
          }
        }
      }
    }
    totals.push(dayDue); counts.push(dayTaken); labels.push(weekdayLabel((day + 4) % 7));
    due = due + dayDue; taken = taken + dayTaken; day = day + 1;
  }
  let subtitle: string = "No doses due yet.";
  if (due > 0) { subtitle = ui.numberToString(taken) + " of " + ui.numberToString(due) + " due doses taken."; }
  return ui.Section("content", "Last seven days", subtitle, [
    ui.Progress("success", "Adherence", taken, math.max(1, due)),
    ui.Sparkline("success", counts, math.max(1, due), "", false, totals, "muted", "Taken", "Due", labels)
  ]);
}
function viewToday(state: AppState): ui.View {
  let cards: ui.View[] = []; let total: number = 0; let taken: number = 0;
  // Chronological, even when medicines were entered in another order.
  let minutes: number[] = [];
  for (let m: Medicine of state.medicines) {
    if (scheduled(m, state.day)) {
      for (let minute: number of m.times) { if (!hasNumber(minutes, minute)) { minutes.push(minute); } }
    }
  }
  let previous: number = -1; let step: number = 0;
  while (step < minutes.length()) {
    let minute: number = 1440;
    for (let candidate: number of minutes) { if (candidate > previous && candidate < minute) { minute = candidate; } }
    for (let m: Medicine of state.medicines) {
      if (scheduled(m, state.day) && hasNumber(m.times, minute)) {
        total = total + 1;
        let status: string = doseStatus(state, m.id, state.day, minute);
        let actions: ui.View[] = []; let caption: string = "Upcoming"; let tone: string = "default";
        if (time.atLocalTime(state.day, minute) < state.now) { caption = "Due"; tone = "warning"; }
        if (status === "") {
          actions.push(ui.Button("primary", "Take", "takeDose", m.id * 1440 + minute, true));
          actions.push(ui.Button("secondary", "Skip", "skipDose", m.id * 1440 + minute, true));
        } else {
          caption = status; tone = "success";
          if (status === "taken") { taken = taken + 1; } else { tone = "muted"; }
          actions.push(ui.Button("secondary", "Undo", "undoDose", m.id * 1440 + minute, true));
        }
        cards.push(ui.Card("surface", [
          ui.Row("split", [ui.ClockText("heading", minute, "", ""), ui.Badge(tone, caption, "")]),
          ui.Text("heading", m.name), ui.Text("body", m.dosage),
          ui.Text("caption", m.notes), ui.ActionBar("default", actions)
        ]));
      }
    }
    previous = minute; step = step + 1;
  }
  let children: ui.View[] = [
    ui.Header("default", "PillPal", "MEDICINE REMINDERS", ui.dateToString(state.day), "calendar"),
    navigation(state),
    ui.Hero("accent", "TODAY", "A little care, every day", ui.numberToString(taken) + " of " + ui.numberToString(total) + " doses taken", [
      ui.Progress("success", "Today's medicines", taken, math.max(1, total))
    ])
  ];
  if (cards.length() === 0) {
    children.push(ui.EmptyState("default", "No doses today", "Add a medicine or check its scheduled days.", "Add medicine", "openNew", "calendar"));
  }
  for (let card: ui.View of cards) { children.push(card); }
  children.push(calendarView(state));
  if (state.medicines.length() > 0) { children.push(adherenceView(state)); }
  children.push(ui.Ticker("default", "pillpal-clock", 60000, true, "refresh"));
  return ui.Screen("today", children);
}
function viewMedicines(state: AppState): ui.View {
  let rows: ui.View[] = [];
  for (let m: Medicine of state.medicines) {
    rows.push(ui.ListItem("default", m.name, scheduleLabel(m), m.dosage, "openEdit", m.id, true, "calendar"));
  }
  let children: ui.View[] = [
    ui.Header("default", "Your medicines", "PILLPAL", "Schedules and reminders, all in one place.", "list"),
    navigation(state)
  ];
  if (rows.length() === 0) {
    children.push(ui.EmptyState("default", "Nothing added yet", "Start with a medicine and choose when to take it.", "Add medicine", "openNew", "plus"));
  } else { children.push(ui.ListGroup("default", "", rows)); }
  children.push(calendarView(state));
  children.push(ui.BackHandler("goToday"));
  children.push(ui.Ticker("default", "pillpal-clock", 60000, true, "refresh"));
  return ui.Screen("medicines", children);
}
function viewEditor(state: AppState): ui.View {
  let title: string = "Add a medicine";
  if (state.draft.id > 0) { title = "Edit medicine"; }
  let timeLabels: string[] = [];
  for (let minute: number of state.draft.times) { timeLabels.push(ui.clockToString(minute)); }
  let days: ui.View[] = []; let day: number = 0;
  while (day < 7) {
    let style: string = "default";
    if (hasNumber(state.draft.weekdays, day)) { style = "accent"; }
    days.push(ui.Cell(style, weekdayLabel(day), "toggleDay", day, true)); day = day + 1;
  }
  let dateFields: ui.View[] = [
    ui.DateField("default", "Starts", state.draft.startDay, "setStart"),
    ui.Toggle("default", "Set an end date", state.draft.endDay >= 0, "setHasEnd")
  ];
  if (state.draft.endDay >= 0) { dateFields.push(ui.DateField("default", "Ends", state.draft.endDay, "setEnd")); }
  // Validation belongs beside Save, not below several screens of form fields.
  let feedback: ui.View = ui.Spacer("none");
  if (state.error !== "") { feedback = ui.InsetBanner("warning", "Check your entry", state.error, "", "", "warning"); }
  else if (state.busy) { feedback = ui.Text("muted", "Calendar update in progress. You can save when it finishes."); }
  let children: ui.View[] = [
    ui.Header("default", title, "PILLPAL", "Changes stay in this draft until you save.", "calendar"),
    ui.ActionBar("default", [
      ui.Button("secondary", "Cancel", "cancelEdit", 0, true),
      ui.Button("primary", "Save medicine", "saveMedicine", 0, !state.busy)
    ]),
    feedback,
    ui.Section("content", "Medicine", "", [
      ui.TextField("default", "Name", state.draft.name, "setName"),
      ui.TextField("default", "Dose", state.draft.dosage, "setDosage"),
      ui.TextField("default", "Notes", state.draft.notes, "setNotes")
    ]),
    ui.Section("content", "Reminder times", "Select a time to change it.", [
      ui.Select("default", "Times", timeLabels, state.timeIndex, "selectTime"),
      ui.TimeField("default", "Reminder time", state.draft.times[state.timeIndex], "setTime"),
      ui.ActionBar("default", [
        ui.Button("secondary", "Add time", "addTime", 0, true),
        ui.Button("secondary", "Remove time", "removeTime", 0, state.draft.times.length() > 1)
      ])
    ]),
    ui.Section("content", "Days", "", [
      ui.Grid("compact", 4, days),
      ui.ActionBar("default", [
        ui.Button("secondary", "Every day", "presetDays", 0, true),
        ui.Button("secondary", "Weekdays", "presetDays", 1, true),
        ui.Button("secondary", "Weekends", "presetDays", 2, true)
      ])
    ]),
    ui.Section("content", "Course dates", "", dateFields)
  ];
  if (state.draft.id > 0) { children.push(ui.Button("danger", "Remove medicine", "askDelete", state.draft.id, !state.busy)); }
  children.push(ui.BackHandler("cancelEdit"));
  children.push(ui.Ticker("default", "pillpal-clock", 60000, true, "refresh"));
  return ui.Screen("edit-" + ui.numberToString(state.draft.id), children);
}
function viewDelete(state: AppState): ui.View {
  let title: string = "Remove medicine?"; let at: number = medicineIndex(state, state.deleteId);
  if (at >= 0) { title = "Remove " + state.medicines[at].name + "?"; }
  return ui.Screen("delete-" + ui.numberToString(state.deleteId), [
    ui.Header("default", "Remove medicine", "PILLPAL", "", "warning"),
    ui.Card("warning", [
      ui.Text("heading", title),
      ui.Text("body", "Its dose log will be removed. Upcoming calendar reminders will be deleted; failed deletions remain available for retry."),
      ui.ActionBar("default", [
        ui.Button("secondary", "Keep medicine", "cancelDelete", 0, true),
        ui.Button("danger", "Remove", "deleteMedicine", 0, !state.busy)
      ])
    ]), ui.BackHandler("cancelDelete")
  ]);
}
function view(state: AppState): ui.View {
  let screen: ui.View = ui.Spacer("none");
  if (state.screen === "edit") { screen = viewEditor(state); }
  else if (state.screen === "medicines") { screen = viewMedicines(state); }
  else if (state.screen === "delete") { screen = viewDelete(state); }
  else { screen = viewToday(state); }
  return ui.AppTheme("soft", "", [screen]);
}
